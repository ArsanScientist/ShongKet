<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Shongket uses a single light palette (no dark UI), so the splash stays light in night mode too
         to match the app that loads right after it. -->
    <style name="Theme.Shongket" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#064A3F</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Shongket.Main</item>
    </style>
    <style name="Theme.Shongket.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F7F6F2</item>
        <item name="android:navigationBarColor">#F7F6F2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>