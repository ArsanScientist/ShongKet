<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground. Simple Shongket mark: a clean circle with horizontal bar.
     The adaptive-icon safe zone is the middle 72 of 108. The mark is scaled to fit
     comfortably inside the safe zone so launchers (circle, squircle, teardrop) don't clip it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <group
      android:pivotX="54"
      android:pivotY="54"
      android:scaleX="0.55"
      android:scaleY="0.55">

    <!-- outer circle -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,30 m-24,0 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6" />
    <!-- horizontal bar - representing the "S" in Shongket / সংকেত -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M26,54 L82,54"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="8" />
  </group>
</vector>